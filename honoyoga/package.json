{
  "name": "@payloadcms/honoyoga",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Hono + GraphQL Yoga worker for the CMS read API.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8787",
    "format": "prettier --write \"src/**/*.ts\" \"README.md\" \"package.json\" \"tsconfig.json\" \"wrangler.jsonc\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.44.7",
    "graphql": "^16.0.0",
    "graphql-yoga": "^5.0.0",
    "hono": "^4.0.0",
    "jose": "^6.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
